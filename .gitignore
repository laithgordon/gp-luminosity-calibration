# ── Raw simulation data (too large for git — regenerate from GUINEA-PIG++ runs) ──
*.ref
*.dat
output/
output_nm/
output_no_pairs/
sampling/
sampling_nm/

# ── Scratch / temporary render outputs ──
temp_*.png
*.tmp

# ── Backups & caches ──
*.bak
*.bak-*
.*_cache.json
lumi_extract_report.txt

# ── Python ──
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# ── OS / editor cruft ──
.DS_Store
Thumbs.db
*.swp

# ── Not part of the published analysis (working files, drafts, backups) ──
unpublished/

# ── Published GP++ input file (the *.dat rule above is for raw dumps) ──
!inputs/*.dat
